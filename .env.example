# Beds24 API credentials
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# Beds24 refresh token for each property.
# Obtained by exchanging a Beds24 invite code via GET /authentication/setup.
# Key format: BEDS24_REFRESH_TOKEN_{PROPERTY_ID_UPPERCASED_LABEL}
BEDS24_REFRESH_TOKEN_CHILL_ZONE=
